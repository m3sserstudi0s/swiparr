# Every key this app reads, no values. Copy to .env for a local run.
#
# AUTH_SECRET is required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Which provider the instance serves. One of: jellyfin | emby | plex | tmdb
PROVIDER=jellyfin
# Lock the provider so a user cannot switch it in the UI.
PROVIDER_LOCK=

# Provider endpoints. From a host process use the OrbStack name (jellyfin.orb.local:8096),
# from a container use the service name (http://jellyfin:8096).
JELLYFIN_URL=
JELLYFIN_PUBLIC_URL=
JELLYFIN_USE_WATCHLIST=
EMBY_URL=
EMBY_PUBLIC_URL=
PLEX_URL=
PLEX_PUBLIC_URL=

# Hybrid decks: a TMDB v4 read access token (JWT, ~239 chars), sent as Bearer.
# The v3 32-char api key is a different credential and will 401.
TMDB_ACCESS_TOKEN=
TMDB_DEFAULT_REGION=SE

# Database. Defaults to file:swiparr.db outside production; the container uses /app/data.
DATABASE_URL=

# Public origin, used by metadata, OG cards and the session cookie.
APP_PUBLIC_URL=

# Optional
ENABLE_DEBUG=
ALLOW_PRIVATE_PROVIDER_URLS=
CSP_FRAME_ANCESTORS=
LOG_LEVEL=
